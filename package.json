{
  "name": "birthday-buddy",
  "version": "1.0.0",
  "description": "Birthday Buddy — Team Birthday Reminder Desktop Application",
  "main": "out/main/index.js",
  "author": "Birthday Buddy Team",
  "license": "MIT",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "dev:main": "node scripts/build-main.js && electron .",
    "build:main": "node scripts/build-main.js",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && npm run build:main",
    "dist": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable",
    "test": "vitest run"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "canvas-confetti": "^1.9.4",
    "date-fns": "^4.1.0",
    "electron-log": "^5.2.4",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.4.7",
    "jimp": "^1.6.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.12.0",
    "uuid": "^11.0.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/sql.js": "^1.4.9",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
